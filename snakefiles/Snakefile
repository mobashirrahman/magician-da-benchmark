                             "metrics_aggregated/relative.tsv", "metrics_aggregated/breadth.tsv", "metrics_aggregated/coverage.tsv"],
        # Sample metadata for DA analysis
        sample_metadata = "sample_metadata.tsv",
        # Differential abundance results
        # da_results = expand("da/{metric}/ALL_methods.done", metric=METRICS_LIST)

