# Extract and write metadata
rule camisim_metafiles:
    """
    @brief
        Extracts metadata for a single sample from the main community input file.
        This includes genome paths, abundances, and creates a checkfile.
    @param wildcards:
        - `sample`: The name of the community to simulate.
    @output:
        - `camisim_metafile`: Tab-separated metadata for CAMISIM.
        - `camisim_genomefile`: Mapping of internal IDs to genome files.
        - `camisim_abundance`: Distribution of abundances for the sample.
        - `fasta_checkfile`: An empty file to signal completion.
    """
    params:
        sample_col = "{sample}",
        samplefile = SAMPLE_FILE
    output:
        camisim_metafile = 'camisim_configfiles/metadata_{sample}',
        camisim_genomefile = 'camisim_configfiles/id_to_genome_file_{sample}',
        camisim_abundance = 'camisim_configfiles/id_to_distributions_{sample}',
        fasta_checkfile = 'camisim_fasta_{sample}/{sample}_checkfile'
    #conda: pathlib.Path(workflow.current_basedir).parent / "requirements.yml"
    shell:
        '''
        python3 {MAGICIAN_DIR}/camisim_setup/extract_camisim_data.py \
        {params.samplefile} {params.sample_col}
        touch camisim_fasta_{params.sample_col}/{params.sample_col}_checkfile
        '''

rule get_samtools_path:
    """
    @brief
        Finds the absolute path to the `samtools` executable in the current
        conda environment.
    @output:
        - `samtools_path`: A temporary file containing the path to samtools.
    """
    output:
        samtools_path = temp("samtools_path.txt")
    conda: "cami_env_py2"
    shell:
        """
        which samtools > {output.samtools_path}
        """


# Write configuration file for Camisim
rule camisim_configfiles:
    """
    @brief
        Generates the INI configuration file required to run CAMISIM.
    @param wildcards:
        - `sample`: The name of the community to simulate.
    @input:
        - `camisim_metafile`: The metadata file for the sample.
        - `camisim_genomefile`: The genome ID mapping file for the sample.
        - `camisim_abundance`: The abundance distribution file for the sample.
        - `samtools_path`: The file containing the path to samtools.
    @output:
        - `camisim_configfile`: The generated .ini file for CAMISIM.
    """
    input:
        camisim_metafile = 'camisim_configfiles/metadata_{sample}',
        camisim_genomefile = 'camisim_configfiles/id_to_genome_file_{sample}',
        camisim_abundance = 'camisim_configfiles/id_to_distributions_{sample}',
        samtools_path = "samtools_path.txt"
    params:
        camisim_dir = CAMISIM_DIR,
        #coverage = 20,
        samplesize = 2.5,
        profile_type = PROFILE_TYPE,
        profile_base = "" if not PROFILE_NAME \
            else "--profile_basename '{}'".format(pathlib.Path(PROFILE_NAME).stem),
        profile_readlength = "" if not READLENGTH \
            else "--profile_readlength {}".format(READLENGTH),
        insert_size = INSERT_SIZE,
        errorprofile_dir = str(pathlib.Path(CAMISIM_DIR) / "tools" / "art_illumina-2.3.6" / "profiles") if not PROFILE_NAME \
            else pathlib.Path(PROFILE_NAME).parent
    output:
        camisim_configfile = 'camisim_config_{sample}.ini'
    #conda: pathlib.Path(workflow.current_basedir).parent / "requirements.yml"
    shell:
         '''
         python3 {MAGICIAN_DIR}/camisim_setup/generate_camisim_config.py \
         {params.camisim_dir} {input.camisim_metafile} {input.camisim_genomefile} -f {output.camisim_configfile} \
         -o "camisim_out/{wildcards.sample}" -a {input.camisim_abundance} -s {params.samplesize} \
         --insert_size {params.insert_size} \
         --read_sim "art" \
         --read_sim_path "{params.camisim_dir}/tools/art_illumina-2.3.6/art_illumina" \
         --samtools_path "{input.samtools_path}" \
         --error_profile "{params.errorprofile_dir}" \
         --art_profile_type {params.profile_type} {params.profile_base} {params.profile_readlength}
         '''

# Run CAMISIM on sample, then make one file each with pooled forward & reverse reads
rule run_camisim:
    """
    @brief
        Runs the CAMISIM metagenome simulation and pools the resulting reads
        into single forward (R1) and reverse (R2) files.
    @param wildcards:
        - `sample`: The name of the community being simulated.
    @input:
        - `camisim_configfile`: The .ini configuration file for CAMISIM.
    @output:
        - `concat_results_r1`: Gzipped FASTQ file for all R1 reads.
        - `concat_results_r2`: Gzipped FASTQ file for all R2 reads.
    """
    input:
        camisim_configfile = 'camisim_config_{sample}.ini'
    output:
        concat_results_r1 = 'camisim_out/{sample}/simulated_{sample}_r1.gz',
        concat_results_r2 = 'camisim_out/{sample}/simulated_{sample}_r2.gz'
    conda: "cami_env_py2_fixed"
    resources: camisim_jobs=1
    shell:
        '''
        rm -rf camisim_out/{wildcards.sample}
        python3 {CAMISIM_DIR}/metagenomesimulation.py {input.camisim_configfile}
        cat camisim_out/{wildcards.sample}/*/reads/*1.fq.gz > {output.concat_results_r1}
        cat camisim_out/{wildcards.sample}/*/reads/*2.fq.gz > {output.concat_results_r2}
        '''

# Move CAMISIM result files, clear out genome locations and metadata
rule cleanup_camisim:
    """
    @brief
        Cleans up the CAMISIM output directory by moving results and
        removing intermediate metadata files.
    @param wildcards:
        - `sample`: The name of the community being cleaned.
    @input:
        - `camisim_resultdir`: The main output directory for the CAMISIM run.
        - `camisim_result_check`: The pooled R1 reads, used as a checkpoint.
    @output:
        - `camisim_check_old`: An empty checkfile to signal completion of cleanup.
    """
    input:
        camisim_resultdir = "camisim_out/{sample}",
        camisim_result_check = "camisim_out/{sample}/simulated_{sample}_r1.gz"  # check if this has updated
    output:
        camisim_check_old = "camisim_old_runs/{sample}/{sample}"
    shell: '''
        mv {input.camisim_resultdir}/*_*_sample_0 camisim_old_runs/{wildcards.sample}
        rm {input.camisim_resultdir}/internal/genome_locations.tsv
        rm {input.camisim_resultdir}/internal/meta_data.tsv
        touch camisim_old_runs/{wildcards.sample}/{wildcards.sample}
        '''

# Run fastQC on forward/reverse reads
rule fastqc:
    """
    @brief
        Runs FastQC to generate quality control reports for the simulated reads.
    @param wildcards:
        - `sample`: The name of the sample being analyzed.
    @input:
        - `reads_r1`: Gzipped FASTQ file of R1 reads.
        - `reads_r2`: Gzipped FASTQ file of R2 reads.
    @output:
        - `qc_r1`: HTML quality report for R1 reads.
        - `qc_r2`: HTML quality report for R2 reads.
    """
    input:
        reads_r1 = 'camisim_out/{sample}/simulated_{sample}_r1.gz',
        reads_r2 = 'camisim_out/{sample}/simulated_{sample}_r2.gz'
    output:
        qc_r1 = 'qc/{sample}/simulated_{sample}_r1_fastqc.html',
        qc_r2 = 'qc/{sample}/simulated_{sample}_r2_fastqc.html'
    conda: "read_qc"
    shell:
        '''
        fastqc -o qc/{wildcards.sample} {input.reads_r1} {input.reads_r2}
        '''

# Quality and adapter trim the raw reads
rule trim_bbduk:
    """
    @brief
        Trims adapters and low-quality sequences from the raw reads using BBDuk.
    @param wildcards:
        - `sample`: The name of the sample being trimmed.
    @input:
        - `R1`: Raw R1 reads for the sample.
        - `R2`: Raw R2 reads for the sample.
    @output:
        - `R1`: Trimmed R1 reads.
        - `R2`: Trimmed R2 reads.
        - `RS`: Trimmed singleton reads.
    """
    input:
        R1 = "camisim_out/{sample}/simulated_{sample}_r1.gz",
        R2 = "camisim_out/{sample}/simulated_{sample}_r2.gz"
    output:
        R1 = "trimReads/{sample}/simulated_{sample}_r1.trim.fq.gz",
        R2 = "trimReads/{sample}/simulated_{sample}_r2.trim.fq.gz",
        RS = "trimReads/{sample}/simulated_{sample}_S.trim.fq.gz"
    threads: 8
    conda: "bbtools_new"
    shell:
        '''
        bbduk.sh -Xmx12g in={input.R1} in2={input.R2} out={output.R1} out2={output.R2} outs={output.RS} overwrite=t \
        minlen=50 qtrim=r trimq=20 k=19 mink=11 threads={threads} ref=adapters ktrim=n
        '''


# Do metagenomic assembly using metaSpades
rule asm_metaspades:
    """
    @brief
        Performs metagenomic assembly of the trimmed reads using metaSPAdes.
    @param wildcards:
        - `sample`: The name of the sample being assembled.
    @input:
        - `R1`: Trimmed R1 reads.
        - `R2`: Trimmed R2 reads.
        - `RS`: Trimmed singleton reads.
    @output:
        - `fa`: Assembled scaffolds in FASTA format.
    """
    input:
        R1 = "trimReads/{sample}/simulated_{sample}_r1.trim.fq.gz",
        R2 = "trimReads/{sample}/simulated_{sample}_r2.trim.fq.gz",
        RS = "trimReads/{sample}/simulated_{sample}_S.trim.fq.gz"
    output:
        fa = "metaspades/{sample}/{sample}_scaffolds.fasta"
    params:
        dir = "metaspades/{sample}",
        asm = "metaspades/{sample}/scaffolds.fasta"
    log:
        out = "logs/asm_metaspades/{sample}.out",
        err = "logs/asm_metaspades/{sample}.err"
    benchmark:
        "benchmarks/{sample}.metaspades.bm.txt"
    threads: 20
    conda: "metaspades_env"
    shell:
        '''
        metaspades.py -t {threads} -1 {input.R1} -2 {input.R2} -s {input.RS} \
        -o {params.dir} -k 27,47,67,87,107,127 --memory 120 2> {log.err} 1> {log.out}
        mv {params.asm} {output.fa}
        '''

# Clean up after metaspades
# Remove leftover files and compress final output
# Should only run when final metaspades output and some junk is present
rule cleanup_metaspades:
    """
    @brief
        Cleans up intermediate files and directories generated by metaSPAdes.
    @param wildcards:
        - `sample`: The name of the sample whose assembly files are being cleaned.
    @input:
        - `dir`: The metaSPAdes output directory.
        - `scaf`: The final filtered scaffolds file (used as a checkpoint).
        - `junk`: An intermediate contigs file to be removed.
    @output:
        - `cleanup`: An empty file to signal completion of cleanup.
    """
    input:
        dir="metaspades/{sample}",
        scaf="metaspades/{sample}/simulated_{sample}.scaf.min1000.fa",
        junk="metaspades/{sample}/contigs.fasta"
    output:
        cleanup="metaspades/{sample}/cleanup.txt"
    threads: 8
    shell:
                '''
        rm -f {input.dir}/contigs.paths
        rm -f {input.dir}/scaffolds.paths
        rm -f {input.dir}/first_pe_contigs.fasta
        rm -f {input.dir}/before_rr.fasta
        rm -rf {input.dir}/K27 {input.dir}/K47 {input.dir}/K67 {input.dir}/K87 {input.dir}/K107 {input.dir}/K127 {input.dir}/corrected
        rm -f {input.junk}
        cd {input.dir} && pigz -q -p {threads} *.fasta *.fastg *.gfa && cd ../..
        touch {output.cleanup}
                '''

# Remove small scaffolds and add sample prefix to fasta header
rule filter_scafs:
    """
    @brief
        Filters the assembled scaffolds to remove those shorter than 1000bp
        and adds the sample name as a prefix to each scaffold header.
    @param wildcards:
        - `sample`: The name of the sample, used as the prefix.
    @input:
        - `asm`: The raw assembled scaffolds from metaSPAdes.
    @output:
        - `asm`: The filtered and renamed scaffolds.
    """
    input:
        asm="metaspades/{sample}/{sample}_scaffolds.fasta"
    output:
        asm="metaspades/{sample}/simulated_{sample}.scaf.min1000.fa"
    params:
        pfx="{sample}" 
    threads: 1
    conda: "bbmap_env"
    shell:
        '''
        
        rename.sh ow=t fastawrap=60 minscaf=1000 prefix={params.pfx} addprefix=t in={input.asm} out={output.asm}
        '''

# Map reads to assembly to get coverage and depth
rule map_bbmap:
    """
    @brief
        Maps the trimmed reads back to the filtered assembly scaffolds using BBMap
        to generate alignment and coverage depth information.
    @param wildcards:
        - `sample`: The name of the sample being mapped.
    @input:
        - `R1`: Trimmed R1 reads.
        - `R2`: Trimmed R2 reads.
        - `fa`: Filtered and renamed scaffolds.
    @output:
        - `outsam`: The alignment in SAM format.
        - `outbam`: The sorted alignment in BAM format.
        - `dep`: A text file containing per-contig depth information.
    """
    input:
        R1="trimReads/{sample}/simulated_{sample}_r1.trim.fq.gz",
        R2="trimReads/{sample}/simulated_{sample}_r2.trim.fq.gz",
        fa="metaspades/{sample}/simulated_{sample}.scaf.min1000.fa"
    output:
        outsam="mapped/{sample}.sam",
        outbam="mapped/{sample}.sort.bam",
        dep="coverage/{sample}.txt"
    log:
        out="logs/map_bbmap/{sample}.out",
        err="logs/map_bbmap/{sample}.err"
    threads: 20
    conda: "bbmap_env"
    shell:
            '''
            
            mkdir -p logs/map_bbmap
            bbmap.sh in={input.R1} in2={input.R2} minid=0.90 threads={threads} ref={input.fa} outm={output.outsam} overwrite=t nodisk=t 2> {log.err} 1> {log.out}
            samtools view -bSh1 {output.outsam} | samtools sort -m 20G -@ 3 > {output.outbam}
            jgi_summarize_bam_contig_depths {output.outbam} --outputDepth {output.dep}
            '''
    #module load ngs tools
    #module load perl
    #module load java/1.8.0
    #module load bbmap/36.49
    #module load samtools/1.10
    #module load metabat/2.12.1

# Use MetaBat2 to bin scaffolds from sample
rule metabat2:
    """
    @brief
        Bins the assembled scaffolds into metagenome-assembled genomes (MAGs)
        using MetaBAT2, based on coverage depth and sequence composition.
    @param wildcards:
        - `sample`: The name of the sample being binned.
    @input:
        - `asm`: The filtered scaffolds for the sample.
        - `dep`: The per-contig coverage depth file.
    @output:
        - A prefix for the output bin files (`.fa`).
    """
    input:
        asm = "metaspades/{sample}/simulated_{sample}.scaf.min1000.fa",
        dep = "coverage/{sample}.txt"
    output:
        "metabat2/{sample}/{sample}.bin"
    params:
        out = "metabat2/{sample}/{sample}.bin",
        binsize = lambda wildcards: 10000 if helpers.check_plasmids(pathlib.Path(SAMPLE_FILE),
            wildcards.sample) else 200000
    log:
        out = "logs/metabat2/{sample}.out",
        err = "logs/metabat2/{sample}.err"
    benchmark:
        "benchmarks/{sample}.metabat2.bm.txt"
    threads: 10
    conda: "bbmap_env"
    shell:
        '''
        mkdir -p logs/metabat2
        metabat -t {threads} -v -m 1500 --saveCls -i {input.asm} -a {input.dep} \
        -o {params.out} --minClsSize {params.binsize} --unbinned --seed 1 2> {log.err} 1> {log.out}
        '''

# Use prodigal to find ORFs in the metagenome and save genes and proteins
rule findgenes_prodigal:
    """
    @brief
        Predicts genes (ORFs) from the assembled scaffolds using Prodigal.
    @param wildcards:
        - `sample`: The name of the sample being annotated.
    @input:
        - `asm`: The filtered scaffolds for the sample.
    @output:
        - `fna`: Predicted genes in nucleotide FASTA format.
        - `faa`: Predicted proteins in amino acid FASTA format.
        - `prodi`: Main prodigal output file.
    """
    input:
        asm="metaspades/simulated_{sample}.scaf.min1000.fa"
    output:
        fna="genes/{sample}/{sample}_genes.fna",
        faa="genes/{sample}/{sample}_proteins.faa",
        prodi="genes/{sample}/{sample}_prodigal.txt"
    threads: 2
    shell:
        '''
        prodigal -i {input.asm} -p meta -a {output.faa} -d {output.fna} -o {output.prodi}
        '''

# Get stats on assembled MAGs
rule sample_stats:
    """
    @brief
        Calculates and summarizes assembly statistics for the generated MAGs.
    @param wildcards:
        - `sample`: The name of the sample.
    @input:
        - `bins`: The prefix for the MAG bin files from MetaBAT2.
    @output:
        - `stats_file`: A TSV file containing statistics for each MAG.
    """
    input:
        bins = "metabat2/{sample}/{sample}.bin"
    output:
        stats_file = "stats/{sample}.tsv"
    conda: "bbtools_new"
    shell:
        '''
        
        statswrapper.sh {input.bins}.*.fa > {output.stats_file}
        '''


rule reference_stats:
    """
    @brief
        Calculates and summarizes assembly statistics for the original reference genomes.
    @param wildcards:
        - `sample`: The name of the sample.
    @input:
        - `refs_checkfile`: A checkfile indicating the reference FASTAs are ready.
    @output:
        - `ref_stats`: A TSV file containing statistics for each reference genome.
    """
    input:
        refs_checkfile = "camisim_fasta_{sample}/{sample}_checkfile"
    params:
        ref_fastas = "camisim_fasta_{sample}"
    output:
        ref_stats = "ref_stats/{sample}_refgenomes.tsv"
    conda: "bbtools_new"
    shell:
        '''
        
        statswrapper.sh {params.ref_fastas}/*.fa > {output.ref_stats}
        '''


# Run checkm on the MAGs to estimate taxonomy and quality
rule checkm:
    """
    @brief
        Assesses the quality (completeness, contamination) of the generated MAGs
        using CheckM.
    @param wildcards:
        - `sample`: The name of the sample.
    @input:
        - `check_file`: The prefix for the MAG bin files from MetaBAT2.
    @output:
        - `txt`: A tab-separated table of CheckM results.
        - `dir`: The main CheckM output directory containing plots and other files.
    """
    input:
        check_file = "metabat2/{sample}/{sample}.bin"
    params:
        dir = "metabat2/{sample}",
        pplacer_threads = 1
    output:
        txt = "checkm/{sample}.checkm.txt",
        dir = directory("checkm/{sample}.checkm")
    threads: 20
    conda: "checkm_env"
    shell:
        '''
        checkm lineage_wf -f {output.txt} -t {threads} --pplacer_threads {params.pplacer_threads} --tab_table -x fa {params.dir} {output.dir}
        '''

rule checkm_refs:
    """
    @brief
        Assesses the quality of the original reference genomes using CheckM.
    @param wildcards:
        - `sample`: The name of the sample.
    @input:
        - `refs_checkfile`: A checkfile indicating the reference FASTAs are ready.
    @output:
        - `ref_txt`: A tab-separated table of CheckM results for the references.
        - `dir`: The main CheckM output directory for the reference analysis.
    """
    input:
        refs_checkfile = "camisim_fasta_{sample}/{sample}_checkfile"
    params:
        ref_fastas = "camisim_fasta_{sample}"
    output:
        ref_txt="ref_checkm/{sample}_refgenomes.checkm.txt",
        dir=directory("ref_checkm/{sample}_refgenomes.checkm")
    threads: 20
    conda: "checkm_env"
    shell:
        '''
        checkm lineage_wf -f {output.ref_txt} -t {threads} --pplacer_threads {threads} --tab_table -x fa \
        {params.ref_fastas} {output.dir}
        '''

# combine original and MAG'ed genomes
rule pool_bins_and_refs_per_sample:
    """
    @brief
        Pools the generated MAGs and the original reference genomes into a
        single directory for comparison.
    @param wildcards:
        - `sample`: The name of the sample.
    @input:
        - `metabat_bins`: The prefix for the MAG bin files from MetaBAT2.
    @output:
        - `all_binned`: An empty checkfile to signal completion of pooling.
    """
    input:
        metabat_bins = "metabat2/{sample}/{sample}.bin"
    output:
        all_binned = "bins_all/{sample}/{sample}"
    
    shell: '''
        cp metabat2/{wildcards.sample}/*.bin.*.fa bins_all/{wildcards.sample}/
        cp camisim_fasta_{wildcards.sample}/*.fa bins_all/{wildcards.sample}/
        touch bins_all/{wildcards.sample}/{wildcards.sample}
        '''
        
# Compare genomes to each other using dRep
rule drep_sample:
    """
    @brief
        Compares all genomes (MAGs and references) for a given sample using dRep
        to identify clusters of closely related genomes (dereplication).
    @param wildcards:
        - `sample`: The name of the sample.
    @input:
        - `check_file`: A checkfile indicating that genome pooling is complete.
    @output:
        - `test`: A PDF figure of the secondary clustering dendrogram from dRep.
        - `mummer_file`: A CSV table of Mash and Mummer comparison data.
        - `reps_dir`: The directory containing the dRep output.
    """
    input:
        check_file = "bins_all/{sample}/{sample}"
    output:
        test = "drep_genomes/{sample}/figures/Secondary_clustering_dendrograms.pdf",
        mummer_file = "drep_genomes/{sample}/data_tables/Ndb.csv",
        reps_dir = directory("drep_genomes/{sample}/dereplicated_genomes")
    params:
        indir = "bins_all/{sample}",
        outdir = "drep_genomes/{sample}"
    threads: 40
    conda: "drep_env"
    shell:
        '''
        dRep compare {params.outdir} -p {threads} -ms 1000 -g {params.indir}/*fa
        '''

# Clean up old dRep results
rule cleanup_drep:
    """
    @brief
        Moves the output directory of a dRep run into an archive folder
        to clean up for a potential new run.
    @param wildcards:
        - `sample`: The name of the sample.
    @input:
        - `drep_check`: A dRep output file, used as a check for completion.
    @output:
        - `check_file`: An empty file to signal that cleanup is complete.
    """
    input:
         drep_check = "drep_genomes/{sample}/figures/Secondary_clustering_dendrograms.pdf"
    output:
          check_file = "drep_old/{sample}/{sample}_move_check"

    shell:
         '''
         mv drep_genomes/{wildcards.sample} drep_old/
         touch drep_old/{wildcards.sample}/{wildcards.sample}_move_check
         '''

rule summarize_results:
    """
    @brief
        Aggregates results from various pipeline steps (stats, CheckM, dRep)
        into a single summary Excel spreadsheet.
    @param wildcards:
        - `sample`: The name of the sample.
    @input:
        - `bin_stats`: Statistics for the MAGs.
        - `ref_stats`: Statistics for the reference genomes.
        - `bin_checkm`: CheckM quality report for the MAGs.
        - `ref_checkm`: CheckM quality report for the reference genomes.
        - `drep_mummer`: dRep comparison data table.
    @output:
        - `summary_stats`: The final combined summary in an Excel file.
    """
    input:
         bin_stats = "stats/{sample}.tsv",
         ref_stats = "ref_stats/{sample}_refgenomes.tsv",
         bin_checkm = "checkm/{sample}.checkm.txt",
         ref_checkm = "ref_checkm/{sample}_refgenomes.checkm.txt",
         drep_mummer = "drep_genomes/{sample}/data_tables/Ndb.csv",
    output:
         summary_stats = "summaries/general_summary_{sample}.xlsx"
    #conda: pathlib.Path(workflow.current_basedir).parent / "requirements.yml"
    shell:
         '''
         python3 {MAGICIAN_DIR}/generate_summary/extract_stats.py \
         {input.bin_stats} {input.ref_stats} {input.bin_checkm} {input.ref_checkm} {input.drep_mummer} \
          -o {output.summary_stats}
         '''

rule make_bin_summary:
    """
    @brief
        Creates a focused comparison table of MAGs and their closest reference
        genomes from the general summary file.
    @param wildcards:
        - `sample`: The name of the sample.
    @input:
        - `summary_stats`: The general summary Excel file.
    @output:
        - `bin_stats`: An Excel file containing the bin-focused comparison table.
    """
    input:
         summary_stats = "summaries/general_summary_{sample}.xlsx"
    output:
          bin_stats = "summaries/bin_summary_{sample}.xlsx"
    #conda: pathlib.Path(workflow.current_basedir).parent / "requirements.yml"
    shell:
         '''
         python3 {MAGICIAN_DIR}/generate_summary/make_comparison_table.py \
         {input.summary_stats} -o {output.bin_stats}
         '''


# ------------------------------------------------------------
# 1.  GTDB-Tk on all MetaBAT2 bins        (before dRep)
# ------------------------------------------------------------
rule gtdbtk_bins:
    """
    GTDB-Tk classify_wf on all MetaBAT2 bins for one sample.
    ──────────────────────────────────────────────────────────
    Outputs:
        gtdbtk_bins/{sample}/gtdbtk.bac120.summary.tsv
        gtdbtk_bins/{sample}/gtdbtk.arc122.summary.tsv
        gtdbtk_bins/{sample}/gtdbtk.tsv    # MAG  ↔  taxonomy
    """
    input:
        bins_prefix = "metabat2/{sample}/{sample}.bin"
    output:
        summary  = "gtdbtk_bins/{sample}/gtdbtk.bac120.summary.tsv",
        taxonomy = "gtdbtk_bins/{sample}/gtdbtk.tsv",
        outdir   = directory("gtdbtk_bins/{sample}")
    threads: 32
    conda: "gtdbtk_env"
    shell:
        """
        mkdir -p {output.outdir}
        BIN_DIR=$(dirname {input.bins_prefix})
        gtdbtk classify_wf \
            --genome_dir   $BIN_DIR \
            --out_dir      {output.outdir} \
            --extension    fa \
            --cpus         {threads}

        echo -e "MAG\tTaxonomy" > {output.taxonomy}
        for f in {output.outdir}/gtdbtk.*.summary.tsv; do
            [ -e "$f" ] || continue
            awk 'NR>1{print $1"\t"$2}' "$f" >> {output.taxonomy}
        done
        """






# ------------------------------------------------------------
# 2.  GTDB-Tk on dRep representatives      (after dRep)
# ------------------------------------------------------------
rule gtdbtk_reps:
    """
    GTDB-Tk classify_wf on the dRep 'winning' genomes.
    Uses the dereplicated_genomes/ folder created by dRep.
    Outputs mirror those of gtdbtk_bins but in gtdbtk_reps/.
    """
    input:
        drep_done  = "drep_genomes/{sample}/figures/Secondary_clustering_dendrograms.pdf",
        reps_dir   = "drep_genomes/{sample}/dereplicated_genomes"
    output:
        summary  = "gtdbtk_reps/{sample}/gtdbtk.bac120.summary.tsv",
        taxonomy = "gtdbtk_reps/{sample}/gtdbtk.tsv",
        outdir   = directory("gtdbtk_reps/{sample}")
    threads: 32
    conda: "gtdbtk_env"
    shell:
        """
        mkdir -p {output.outdir}
        gtdbtk classify_wf \
            --genome_dir   {input.reps_dir} \
            --out_dir      {output.outdir} \
            --extension    fa \
            --cpus         {threads}

        echo -e "MAG\tTaxonomy" > {output.taxonomy}
        for f in {output.outdir}/gtdbtk.*.summary.tsv; do
            [ -e "$f" ] || continue
            awk 'NR>1{print $1"\t"$2}' "$f" >> {output.taxonomy}
        done
        """





# ------------------------------------------------------------
# 3.  Agreement check  (same species before vs. after dRep?)
# ------------------------------------------------------------
rule compare_taxonomy:
    """
    Join the two GTDB-Tk tables on MAG ID and flag mismatches.
    Produces a per-sample detail table + one-line summary.
    """
    input:
        pre  = "gtdbtk_bins/{sample}/gtdbtk.tsv",
        post = "gtdbtk_reps/{sample}/gtdbtk.tsv"
    output:
        table   = "taxonomy_compare/{sample}_agreement.tsv",
        summary = "taxonomy_compare/{sample}_summary.txt"
    conda: "gtdbtk_env"
    script:
        "../workflow/scripts/compare_taxonomy.py"

rule all_compare_taxonomy:
    """
    Aggregate target: run compare_taxonomy for every sample.
    """
    input:
        expand("taxonomy_compare/{sample}_agreement.tsv", sample=SAMPLES)























# ----------------------------------------------------------
#  COVERM   → per-sample coverage tables (reads → genomes)
# ----------------------------------------------------------

rule coverm_metrics:
    """
    @brief
        Map trimmed paired reads directly to all MAG and reference genomes
        using CoverM's built-in minimap2 mapper and calculate coverage
        metrics (count, RPKM, TPM, relative_abundance, breadth, mean depth).
    @param wildcards:
        - `sample`: Sample ID (e.g. T03).
    @input:
        R1 = "trimReads/{sample}/simulated_{sample}_r1.trim.fq.gz",
        R2 = "trimReads/{sample}/simulated_{sample}_r2.trim.fq.gz",
        genome_dir = "bins_all/{sample}"
    @output:
        tsv = "metrics/{sample}.coverage.tsv"
    """
    input:
        R1 = "trimReads/{sample}/simulated_{sample}_r1.trim.fq.gz",
        R2 = "trimReads/{sample}/simulated_{sample}_r2.trim.fq.gz",
        genome_dir = "bins_all/{sample}"
    output:
        tsv = "metrics/{sample}.coverage.tsv"
    threads: 16
    conda: "coverm_env"
    shell:
        '''
        mkdir -p metrics

        # Build space-separated list of genome FASTA files (skip placeholder files)
        GENOMES=$(find {input.genome_dir} -name '*.fa' -type f -size +0c \
                  ! -name '*lowDepth.fa' ! -name '*tooShort.fa' ! -name '*unbinned.fa')

        coverm genome \
            --coupled {input.R1} {input.R2} \
            --genome-fasta-files $GENOMES \
            --methods count rpkm tpm relative_abundance covered_bases mean \
            --min-covered-fraction 0 \
            --threads {threads} \
            --output-file {output.tsv}
        '''

# ----------------------------------------------------------
#  Aggregate – build wide matrices & high-level target
# ----------------------------------------------------------

rule all_metrics:
    """
    Convenience aggregate target that ensures per-sample CoverM tables and
    the downstream wide matrices exist.
    """
    input:
        expand("metrics/{sample}.coverage.tsv", sample=SAMPLES),
        "metrics/counts.tsv",
        "metrics/rpkm.tsv",
        "metrics/tpm.tsv",
        "metrics/relative.tsv",
        "metrics/breadth.tsv",
        "metrics/coverage.tsv"

rule build_metric_matrices:
    """
    Collate all sample CoverM tables into wide matrices (one per metric).
    Rows = samples, columns = Genome IDs.
    """
    input:
        expand("metrics/{sample}.coverage.tsv", sample=SAMPLES)
    output:
        counts   = "metrics/counts.tsv",
        rpkm     = "metrics/rpkm.tsv",
        tpm      = "metrics/tpm.tsv",
        relative = "metrics/relative.tsv",
        breadth  = "metrics/breadth.tsv",
        coverage = "metrics/coverage.tsv"   # mean depth
    run:
        import pandas as pd, glob, pathlib

        mats = {
            'count': [],
            'rpkm':  [],
            'tpm':   [],
            'relative_abundance': [],
            'covered_bases': [],
            'mean': []
        }
        for f in glob.glob("metrics/*.coverage.tsv"):
            df = pd.read_csv(f, sep='\t')
            sample = pathlib.Path(f).stem.replace(".coverage", "")
            cols = {k: [c for c in df.columns if c.endswith(suffix)] for k, suffix in {
                'count': 'Read Count',
                'rpkm': 'RPKM',
                'tpm': 'TPM',
                'relative_abundance': 'Relative Abundance (%)',
                'covered_bases': 'Covered Bases',
                'mean': 'Mean'
            }.items()}
            for key, col_list in cols.items():
                if not col_list:
                    raise KeyError(f"{key} column not found in {f}")
                mats[key].append(df.set_index('Genome')[col_list[0]].rename(sample))

        pd.concat(mats['count'],               axis=1).to_csv(output.counts,   sep='\t')
        pd.concat(mats['rpkm'],                axis=1).to_csv(output.rpkm,     sep='\t')
        pd.concat(mats['tpm'],                 axis=1).to_csv(output.tpm,      sep='\t')
        pd.concat(mats['relative_abundance'],  axis=1).to_csv(output.relative, sep='\t')
        pd.concat(mats['covered_bases'],       axis=1).to_csv(output.breadth,  sep='\t')
        pd.concat(mats['mean'],                axis=1).to_csv(output.coverage, sep='\t')




