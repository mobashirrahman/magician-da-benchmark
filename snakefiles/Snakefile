    """
    input: "coverage/mean_depth.tsv"





# ─────────────────────────────────────────────────────────────
#  CREATE SAMPLE METADATA TABLE
# ─────────────────────────────────────────────────────────────
rule sample_metadata:
    """
    @brief
        Create a simple two-column metadata table (`sample_metadata.tsv`) that
        assigns every sample to the Control or Treatment group required by the
        differential-abundance benchmark.
    @param SAMPLES:
        List of sample identifiers derived from the CAMISIM community file
        header (global variable).
    @output meta:
        Tab-separated file with header `sample    group` used by BenchDamic.
    """
    output:
        meta = "sample_metadata.tsv"
    params:
        sample_list = " ".join(SAMPLES)
    shell:
        """
        set -euo pipefail
        echo -e "sample\tgroup" > {output.meta}
        for sample in {params.sample_list}; do
            if [[ $sample == C* ]]; then
                echo -e "$sample\tControl" >> {output.meta}
            else
                echo -e "$sample\tTreatment" >> {output.meta}
            fi
        done
        """

