#  CONTIG-level mean-depth matrix
# ─────────────────────────────────────────────────────────────
rule build_contig_depth_matrix:
    input:
        expand("coverage/{sample}.txt", sample=SAMPLES)
    output:
        matrix = "coverage/mean_depth.tsv"
    script:
        "../workflow/scripts/build_contig_depth_matrix.py"


